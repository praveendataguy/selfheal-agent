# --- GitLab ---------------------------------------------------------------
GITLAB_URL=https://gitlab.com
# Project or group access token, role Developer+, scopes: api, write_repository
GITLAB_TOKEN=
# Any long random string; paste the same value as the webhook "Secret token"
GITLAB_WEBHOOK_SECRET=

# --- AI provider --------------------------------------------------------------
# mock      : free, no key, only understands the examples/demo-repo bug
# gemini    : free-tier key from aistudio.google.com (prompts may be reviewed by Google)
# anthropic : Claude API key (paid)      vertex : Claude on Google Cloud (paid)
HEALER=duo
LLM_PROVIDER=mock
GEMINI_API_KEY=
# Run `python scripts/list_gemini_models.py` to see the models your key can use
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Only for LLM_PROVIDER=vertex (uses Application Default Credentials)
VERTEX_PROJECT_ID=
VERTEX_REGION=us-east5

# --- Slack approvals --------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=C0123456789
# Comma-separated Slack user IDs allowed to approve (empty = anyone in channel)
SLACK_APPROVER_IDS=

# --- Safety policy ----------------------------------------------------------
MAX_ATTEMPTS=2
MIN_CONFIDENCE=0.55
MAX_FILES_CHANGED=5
PRODUCTION_REFS=main,master,production,release/*
# Start with DRY_RUN=true: the agent analyses and reports to Slack but never pushes
DRY_RUN=true

# --- Google Cloud observability --------------------------------------------
GCP_PROJECT_ID=
FETCH_CLOUD_LOGGING_CONTEXT=false
